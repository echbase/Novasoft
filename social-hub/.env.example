# Copier en .env (jamais committé) — les secrets ne vivent QUE ici.

# Base de données (défaut : sqlite:///social_hub.db)
SOCIAL_HUB_DATABASE_URL=sqlite:///social_hub.db

# Clé API du site RoG Hunting (générée côté Emergent, transmise hors code)
SOCIAL_HUB_SITE_API_KEY_ROG_HUNTING=

# Meta — inutilisés tant que l'App Review n'est pas validée (dry-run strict)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
